# URL de l'API backend (si non définie, utilise les valeurs par défaut selon NODE_ENV)
REACT_APP_API_URL=http://localhost:3001

# Tenant ID par défaut
REACT_APP_DEFAULT_TENANT_ID=le-kremlin-bicetre

# API OpenData Paris (optionnel, valeur par défaut intégrée)
REACT_APP_PARIS_OPENDATA_API=

# API OpenData Paris fontaines à boire (optionnel, valeur par défaut intégrée)
REACT_APP_PARIS_OPENDATA_WATER_API=

# IA base URL (chatbot citoyen, défaut : http://localhost:8000)
REACT_APP_IA_URL=
